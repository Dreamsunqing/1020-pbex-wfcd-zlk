  "calendarUpgrades": {
    "/Lotus/Upgrades/Calendar/AbilityStrength": {
      "name": "力量增长",
      "description": "技能强度 +25%。",
      "englishName": "Power Gains",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/Armor": {
      "name": "厚实皮肤",
      "description": "护甲 +250。",
      "englishName": "Thick Skin",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/AttackAndMovementSpeedOnCritMelee": {
      "name": "一击即走",
      "description": "近战暴击有几率使攻击和移动速度提高 5%，持续 10 秒。",
      "englishName": "Hit'N'Split",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/BlastEveryXShots": {
      "name": "爆炸狂欢",
      "description": "每第 10 次射击命中时施加 10 层爆炸异常。",
      "englishName": "Have A Blast",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/CompanionDamage": {
      "name": "后盾支援",
      "description": "魅影和同伴伤害 +250%。",
      "englishName": "Got Your Back",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/CompanionsBuffNearbyPlayer": {
      "name": "人多势众",
      "description": "20 米内每有一名非 Tenno 友军，范围内这些友军获得 +5% 近战攻速和 +20% 射速。",
      "englishName": "More the Merrier",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/CompanionsRadiationChance": {
      "name": "友方辐射",
      "description": "魅影或同伴的攻击有 25% 几率造成辐射异常。",
      "englishName": "Friendly Fallout",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/ElectricStatusDamageAndChance": {
      "name": "瓶中闪电",
      "description": "所有武器增加 25% 异常伤害及电击异常几率。",
      "englishName": "Bottled Lightning",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/EnergyOrbToAbilityRange": {
      "name": "开阔视野",
      "description": "拾取能量时技能范围 +10%，持续 10 秒。",
      "englishName": "Broadened Horizons",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/EnergyRestoration": {
      "name": "浓缩能量",
      "description": "每秒能量恢复 +2。",
      "englishName": "Espresso Shots",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/EnergyWavesOnCombo": {
      "name": "连击能量波",
      "description": "达到 7 倍连击倍率后，近战攻击发射能量波。",
      "englishName": "Combo Wave",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/FinisherChancePerComboMultiplier": {
      "name": "连击杀手",
      "description": "近战命中后，敌人可被处决的几率随连击倍率提高，每倍率 +5%；Venka Prime 最高 65%。",
      "englishName": "Combo Killer",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/GasChanceToPrimaryAndSecondary": {
      "name": "毒气射击",
