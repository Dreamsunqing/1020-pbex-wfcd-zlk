      "englishName": "Tickshots",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/HealingEffects": {
      "name": "紧急医疗",
      "description": "拾取球体的各类恢复效果提高 25%。",
      "englishName": "Emergency Medicine",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/MagazineCapacity": {
      "name": "重型弹匣",
      "description": "弹匣容量 +25%。",
      "englishName": "Heavy Mags",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/MagnetStatusPull": {
      "name": "吸引之力",
      "description": "磁力异常会牵引周围敌人，每层提供 1 米牵引范围。",
      "englishName": "Force Of Attraction",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/MagnitizeWithinRangeEveryXCasts": {
      "name": "磁力威胁",
      "description": "每第 5 次施放技能，对前方 50 米内一名敌人施加磁力异常。",
      "englishName": "Magnetic Menace",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/MeleeAttackSpeed": {
      "name": "毫不留情",
      "description": "近战攻击速度 +25%。",
      "englishName": "No Quarter",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/MeleeCritChance": {
      "name": "精准练习",
      "description": "近战暴击几率 +20%，重击效果翻倍。",
      "englishName": "Practiced Precision",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/OrbsDuplicateOnPickup": {
      "name": "定向医疗",
      "description": "射击生命球可拾取它；拾取时有 25% 几率复制生命球。",
      "englishName": "Targeted Medicine",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/OvershieldCap": {
      "name": "护盾强化",
      "description": "超量护盾上限 +50%；击杀获得 50 护盾。",
      "englishName": "Harden Up",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/PowerStrengthAndEfficiencyPerEnergySpent": {
      "name": "超载施法",
      "description": "施法每消耗 1 点能量，使技能强度 +2%、效率 -1%，持续 5 秒。",
      "englishName": "Overpower",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/PunchToPrimary": {
      "name": "穿透打卡",
      "description": "主要武器穿透 +1.5 米。",
      "englishName": "Punchcard",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/RadiationProcOnTakeDamage": {
      "name": "灵能反馈",
      "description": "受伤时有 10% 几率触发 5 米范围、250 伤害的辐射爆炸。",
      "englishName": "Psionic Feedback",
      "source": "wfcd-calendar-project-translation"
    },
    "/Lotus/Upgrades/Calendar/RefundBulletOnStatusProc": {
      "name": "免费射击",
